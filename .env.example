# -----------------------------------------------------------------------------
# LinkedIn Content Intelligence Agent - environment configuration
#
# Copy this file to .env.local for local development.
# Every value below is optional in DEMO_MODE=true (the default for local dev
# and for reviewing this project without any paid API keys).
# -----------------------------------------------------------------------------

# When true, the app uses MockResearchProvider, MockAIProvider and
# MockEmbeddingProvider instead of calling any paid API. The seed data and the
# whole pipeline (research -> patterns -> voice -> generation -> critique ->
# performance -> feedback) work end to end in this mode.
DEMO_MODE=true

# ---- Supabase / Postgres ---------------------------------------------------
# Optional even outside DEMO_MODE: when unset, the app uses an in-memory demo
# store instead (see src/lib/data/memory-store.ts). Set these to persist real
# data. Create a free project at https://supabase.com, enable the "vector"
# extension, then run the SQL in supabase/migrations against it (paste it
# into the SQL Editor in the Supabase dashboard and click Run).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key, used by Trigger.dev tasks and server routes that write data.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Research provider ------------------------------------------------------
# Not required when DEMO_MODE=true.
RESEARCH_PROVIDER=seo-pipeline # seo-pipeline | serpapi | firecrawl | mock

# seo-pipeline: a self-hosted SERP-search + scrape REST API (e.g. backed by
# Jina). No API key needed on THIS app's side - the server holds its own key.
# Just point this at your deployed instance's base URL (no trailing slash).
SEO_PIPELINE_BASE_URL=

# serpapi (https://serpapi.com) - used for search(); page content itself is
# fetched directly and cleaned with a built-in HTML->text extractor (see
# src/lib/research/html-extract.ts), since SerpAPI only returns search
# results, not page content. Only used if RESEARCH_PROVIDER=serpapi.
SERPAPI_API_KEY=

# firecrawl (https://firecrawl.dev) - alternative provider that also handles
# page scraping + structured extraction itself. Only used if
# RESEARCH_PROVIDER=firecrawl.
FIRECRAWL_API_KEY=

# ---- AI provider (pattern extraction, voice analysis, generation, critique) -
# Not required when DEMO_MODE=true.
AI_PROVIDER=google # google | nvidia | openrouter | anthropic | openai | mock
AI_MODEL=claude-opus-5-5 # only used for AI_PROVIDER=anthropic or openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google Gemini, called directly (own rate limit, not a shared free pool -
# see the OpenRouter section below for why that matters). Get a key at
# https://aistudio.google.com/apikey (looks like "AIzaSy...").
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=gemini-flash-latest

# NVIDIA's own hosted inference API (https://build.nvidia.com), OpenAI-
# compatible. Own dedicated per-key quota - not a shared free pool like
# OpenRouter's free models, and no tiny per-minute cap like Gemini's free
# tier. Get a key at https://build.nvidia.com (looks like "nvapi-...").
# IMPORTANT: pick a plain instruct model here, NOT a reasoning model
# (deepseek-* etc.) - reasoning models write a long internal "thinking" pass
# before answering, which is slow enough (20-40s+ per call) to blow past
# Vercel's serverless function timeout, since this pipeline makes 3+
# sequential AI calls per request.
NVIDIA_API_KEY=
NVIDIA_AI_MODEL=google/gemma-4-31b-it

# OpenRouter (https://openrouter.ai) - configured with a FALLBACK CHAIN of
# models, tried in order. Free-tier OpenRouter models get rate-limited or
# pulled often, so every AI call here tries model #1 first and instantly
# falls through to #2, #3, etc. on any failure - see src/lib/ai/openrouter.ts
# and src/lib/ai/fallback.ts. The list below is an example; check
# https://openrouter.ai/models?max_price=0 for the current free lineup and
# update it (comma-separated, no spaces needed).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free,qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free,poolside/laguna-s-2.1:free,dots-studio/dots-3-note-preview:free,inclusionai/ling-3.0-flash-fin:free,liquid/lfm-2.5-2.6b:free,openrouter/free
# This list goes stale as OpenRouter's free lineup changes - use
# GET /api/admin/openrouter-models (see src/app/api/admin/openrouter-models)
# on your deployed app to fetch the current free catalog rather than
# trusting this file blindly.

# ---- Embeddings --------------------------------------------------------------
EMBEDDING_PROVIDER=openai # openai | mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Trigger.dev --------------------------------------------------------------
# Required outside DEMO_MODE: the Studio page runs post generation as a
# Trigger.dev background job (see src/trigger/generatePost.ts) rather than
# inline in the request, since real providers (a live search, a page
# scrape, several sequential AI calls) can take well over a minute - longer
# than a serverless function's request timeout allows. Create a free
# project at https://trigger.dev, then:
#   1. Set TRIGGER_PROJECT_ID (from the project's settings page).
#   2. Set TRIGGER_SECRET_KEY (Project settings -> API keys -> use the
#      "prod" secret key for a Vercel Production deployment).
#   3. Deploy your tasks to Trigger.dev: npx trigger.dev@latest deploy
#      (re-run this after any change to src/trigger/*.ts).
# In DEMO_MODE these aren't needed - mock providers respond in milliseconds,
# so the Studio page calls the pipeline directly instead.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# ---- One-time data seeding --------------------------------------------------
# Set to any random string, then (once) visit /api/admin/seed?token=<this value>
# in a browser to push the fictional seed dataset into your real Supabase
# project - an alternative to pasting the SQL in scripts/seed/print-sql.ts's
# output into the SQL Editor by hand. Safe to leave set; without it the
# endpoint always refuses (403).
SEED_ADMIN_TOKEN=
