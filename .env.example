# -----------------------------------------------------------------------------
# LinkedIn Content Intelligence Agent - environment configuration
#
# Copy this file to .env.local for local development.
# Every value below is optional in DEMO_MODE=true (the default for local dev
# and for reviewing this project without any paid API keys).
# -----------------------------------------------------------------------------

# When true, the app uses MockResearchProvider, MockAIProvider and
# MockEmbeddingProvider instead of calling any paid API. The seed data and the
# whole pipeline (research -> patterns -> voice -> generation -> critique ->
# performance -> feedback) work end to end in this mode.
DEMO_MODE=true

# ---- Supabase / Postgres ---------------------------------------------------
# Required for anything beyond DEMO_MODE reads of static seed fixtures.
# Create a free project at https://supabase.com, enable the "vector"
# extension, then run the SQL in supabase/migrations against it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key, used by Trigger.dev tasks and server routes that write data.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Research provider ------------------------------------------------------
# Firecrawl (https://firecrawl.dev). Not required when DEMO_MODE=true.
FIRECRAWL_API_KEY=
RESEARCH_PROVIDER=firecrawl # firecrawl | mock

# ---- AI provider (pattern extraction, voice analysis, generation, critique) -
# Pick one. Not required when DEMO_MODE=true.
AI_PROVIDER=anthropic # anthropic | openai | openrouter | mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Embeddings --------------------------------------------------------------
EMBEDDING_PROVIDER=openai # openai | mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Trigger.dev --------------------------------------------------------------
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
